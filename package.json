{
  "name": "dsh-biomemory",
  "description": "生物仿生记忆系统（Biomimetic Memory for DeepSeek Harness）v0.6.8: 审计双写修复（记忆写入/编辑/删除/钉选同时落 SQLite 与人类可读镜像）+ 备份文件唯一性兜底（同毫秒内连续备份各自独立成文件，不再静默覆盖）+ SQLite 数据层（node:sqlite 内置，零外部依赖）+ 本地嵌入模型语义检索（bge-small-zh-v1.5，离线）+ exact/semantic/hybrid 三模式（exact 相关度优先、weight 限幅 +50%）+ RRF 融合（weight 归一到同量级）+ Markdown 自动迁移 + 冻结快照注入（Memory/Retrieved/Applied 三层分离 + 预算硬上限与逐条截断）+ 审批门（默认 fail-closed）+ 记忆代谢（断点续跑）+ 记忆钉（锁定=不遗忘 + relevance admission）+ 记忆类别与来源（memory_class/source_ref，建议≠决定）+ 结构化审计 + 深度反思 + 知识页 + 可编辑条目 + 冲突浮出置顶 + /memory 命令；管理 UI 按记忆功能设计语言（档案+时光流/紫粉品牌色）+ 深色适配（DSH 主题跟随）",
  "version": "0.6.8",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-session": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\""
  },
  "license": "MIT",
  "files": [
    "index.mjs",
    "db.mjs",
    "embed.mjs",
    "shared.mjs",
    "store.mjs",
    "retrieve.mjs",
    "meta.mjs",
    "snapshot.mjs",
    "gate.mjs",
    "notify.mjs",
    "session-state.mjs",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KLRSL/dsh-biomemory.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "memory",
    "plugin",
    "biomimetic",
    "sqlite",
    "semantic-search",
    "embedding"
  ],
  "homepage": "https://github.com/KLRSL/dsh-biomemory#readme",
  "bugs": {
    "url": "https://github.com/KLRSL/dsh-biomemory/issues"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0"
  },
  "devDependencies": {
    "jsdom": "^25.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "allowScripts": {
    "onnxruntime-node@1.24.3": true,
    "sharp@0.34.5": true
  }
}
