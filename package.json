{
  "name": "dsh-biomemory",
  "description": "cross-session memory for DeepSeek Harness v0.9.1：跨会话记忆（分层记录 · 分级审批 · 记忆代谢 · 结构化审计 · 纯本地 SQLite）。",
  "version": "0.9.1",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-session": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\""
  },
  "license": "MIT",
  "files": [
    "index.mjs",
    "db.mjs",
    "shared.mjs",
    "store.mjs",
    "retrieve.mjs",
    "meta.mjs",
    "snapshot.mjs",
    "gate.mjs",
    "mirror.mjs",
    "extract.mjs",
    "session-state.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KLRSL/dsh-biomemory.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "memory",
    "plugin",
    "biomimetic",
    "sqlite"
  ],
  "homepage": "https://github.com/KLRSL/dsh-biomemory#readme",
  "bugs": {
    "url": "https://github.com/KLRSL/dsh-biomemory/issues"
  },
  "dependencies": {}
}
